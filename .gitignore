# ---------------------------------------------------------------- everywhere
.DS_Store
__pycache__/
*.pyc
.claude/
.vscode/
.idea/

# Python virtual environment: recreate it from Vandan/environment/
.venv/

# --------------------------------------------------------------- Dashboard
Dashboard/frontend/node_modules/
Dashboard/frontend/dist/
Dashboard/frontend/.vite/
Dashboard/backend/config.json
Dashboard/backend/storage/uploads/*
Dashboard/backend/storage/results/*
Dashboard/backend/storage/jobs.sqlite*

# ------------------------------------------------------------------ Vandan
# Raw simulation data. Each .vtk is 102 MB, over GitHub's 100 MB file limit,
# and the full volume set is 5.3 GB. See Vandan/DATA.md for how to get it.
Vandan/input/vtk/
Vandan/input/vdb_sequence/
Vandan/input/ply/
# The 201 converted volumes, except four samples so a real render can be run.
Vandan/input/vdb/*
!Vandan/input/vdb/data.0000.vdb
!Vandan/input/vdb/data.0010.vdb
!Vandan/input/vdb/data.0169.vdb
!Vandan/input/vdb/data.0170.vdb

# Frame-by-frame PNGs (7.8 GB). The videos, proxies, thumbnails and stills that
# the dashboard plays ARE committed; only the per-frame folders are left out.
Vandan/output/renders/cme_360/*/
Vandan/output/renders/fieldlines_360/*/
Vandan/output/renders/cme_flat/
Vandan/output/experiments/
Vandan/output/logs/
*.blend1

# Unity rebuilds all of these when the project is opened.
Vandan/unity/*/Library/
Vandan/unity/*/Temp/
Vandan/unity/*/Obj/
Vandan/unity/*/Logs/
Vandan/unity/*/UserSettings/
Vandan/unity/*/Build/
Vandan/unity/*/Builds/
Vandan/unity/*/*.csproj
Vandan/unity/*/*.sln
Vandan/unity/*/*.slnx

# ------------------------------------------------------------------ Sakshi
# Downloaded GOES/EPHIN data, cached on first request so repeat lookups for
# the same period don't re-download. Regenerates automatically.
Sakshi/backend/cache/
# Rendered PNGs from the backend's own standalone HTML UI (not used by the
# three.js dashboard, which reads the JSON API directly).
Sakshi/backend/static/plots/
